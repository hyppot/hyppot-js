{
  "name": "@hyppot/types",
  "version": "0.3.1",
  "private": true,
  "description": "Shared Hyppot DTO types for SDKs",
  "author": "Hyppot (https://hyppot.com)",
  "license": "Apache-2.0",
  "repository": "https://github.com/hyppot/Hyppo",
  "homepage": "https://hyppot.com/docs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
